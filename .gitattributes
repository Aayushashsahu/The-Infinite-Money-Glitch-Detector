# Normalize all text and artifact files to LF on checkout and commit across all OSes
* text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
data/results/** text eol=lf

# Explicitly treat raw data files, archives, and databases as immutable binary blobs
data/raw/** -text
data/processed/** -text
*.db -text
*.csv.gz -text
