# Infinite Money Glitch Detector - environment variables
#
# Phase 1 needs no credentials. Phase 2 uses DATABASE_URL for storage;
# data-source APIs below are keyless unless noted. Never commit real .env.

# Database (Phase 2 storage; PostgreSQL in production)
# postgresql+psycopg2://user:password@localhost:5432/gmdb
DATABASE_URL=

# FRED requires a free API key (https://fred.stlouisfed.org/docs/api/api_key.html)
# FRED_API_KEY=

# Reserved for later phases (not used in Phase 2)
# EXCHANGE_RATE_PROVIDER_API_KEY=
# REDIS_URL=
# LLM_API_KEY=
